# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5433/ragdb

# CORS allowed origins (comma-separated). Defaults to standard localhost dev ports.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# NVIDIA model access is used for contextual follow-up resolution and answers.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Langfuse tracing is fail-open. Content capture is disabled by default.
LANGFUSE_ENABLED=true
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
